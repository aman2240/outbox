# --- Backend server ---
PORT=4000
NODE_ENV=development

# --- Postgres ---
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Sessions ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Google OAuth (login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Slack OAuth (per-user "Connect Slack" notifications) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback

# Temporary manual test-only override used before Slack OAuth exists (Phase 3).
# Once Phase 4's OAuth flow is wired up, real per-user webhook URLs from the
# slack_integrations table are used instead and this is ignored.
SLACK_TEST_WEBHOOK_URL=

# --- Ethereal (fake SMTP for demoing "sent" email) ---
# Populate by running `npm run create-ethereal-senders` inside /backend,
# which also inserts rows into the `senders` table directly.
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Worker / rate limiting tuning ---
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
